#/bin/bash

ng xi18n --output-path locale
cd src/locale
cp messages.en.xlf messages.en.old
cp messages.fr.xlf messages.fr.old

cp messages.xlf messages.orig
sed '/id="ngb./,+6 d' messages.orig | sed '/node_modules/,+3 d' > messages.xlf

sed '/<source>/{p;s/source/target/g;}' messages.xlf > messages.en.xlf
cp messages.en.xlf messages.fr.xlf

