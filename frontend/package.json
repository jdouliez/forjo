{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host '0.0.0.0' --proxy-config conf/proxy.prod.conf.json --disable-host-check",
    "dev": "ng serve --host '0.0.0.0' --proxy-config conf/proxy.dev.conf.json --disable-host-check",
    "dev:watch": "nodemon --watch src --exec npm run dev",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "lint_ic": "ng lint 'frontend' --force --format checkstyle > checkstyle.xml",
    "e2e": "ng e2e",
    "sonar": "sonar-scanner -Dsonar.projectKey=forjo-frontend -Dsonar.projectName=forjo-frontend -Dsonar.projectVersion=0.0.0 -Dsonar.sourceEncoding=UTF-8 -Dsonar.sources=src -Dsonar.exclusions='** /node_modules/** ,** /* .spec.ts' -Dsonar.ts.tslintconfigpath=tslint.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^7.2.15",
    "@angular/cdk": "^7.3.7",
    "@angular/common": "~7.2.15",
    "@angular/compiler": "~7.2.15",
    "@angular/core": "~7.2.15",
    "@angular/flex-layout": "^7.0.0-beta.23",
    "@angular/forms": "~7.2.15",
    "@angular/material": "^7.3.7",
    "@angular/platform-browser": "~7.2.15",
    "@angular/platform-browser-dynamic": "~7.2.15",
    "@angular/router": "~7.2.15",
    "@ng-bootstrap/ng-bootstrap": "^4.1.3",
    "@nguniversal/express-engine": "^7.1.1",
    "@types/intro.js": "^2.4.5",
    "angular-messages": "^1.7.8",
    "bootstrap": "^3.3.7",
    "chart.js": "^2.8.0",
    "core-js": "^2.5.7",
    "file-saver": "^2.0.2",
    "intro.js": "^2.9.3",
    "jquery": "^3.3.1",
    "ng-messages2": "^0.1.1",
    "ng2-charts": "~2.0.0",
    "ng2-cookies": "^1.0.12",
    "nightmare": "^3.0.2",
    "node-sass": "^4.*",
    "popper.js": "^1.15.0",
    "rxjs": "^6.5.2",
    "rxjs-compat": "^6.5.2",
    "tether": "^1.4.6",
    "ts-md5": "^1.2.4",
    "tslib": "^1.9.3",
    "zone.js": "~0.9.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^0.13.9",
    "@angular/cli": "^7.3.10",
    "@angular/compiler-cli": "^7.2.15",
    "@angular/language-service": "~7.2.15",
    "@types/jasmine": "~3.3.12",
    "@types/jasminewd2": "~2.0.6",
    "@types/node": "^12.0.2",
    "@types/webpack-env": "^1.13.9",
    "codelyzer": "~5.0.1",
    "grunt-karma": "^3.0.2",
    "jasmine-core": "~3.4.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "^4.1.0",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.5",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "protractor": "~5.4.2",
    "source-map": "^0.7.3",
    "ts-node": "~8.1.0",
    "tslint": "~5.16.0",
    "typescript": "~3.2.2"
  }
